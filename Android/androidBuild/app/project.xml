<project>
    <!-- APP CONFIG -->
    <app title="Spritemap to Funky"
         file="SpritemaptoFunky"
         package="com.thejarretlabs.spritemaptofunky"
         version="1.0.0"
         company="JarretLabs"
         main="Main" />

    <icon path="iconAndroid.png" if="android" />

    <android extension="org.haxe.extension.AndroidFilePicker"
             minimum-sdk-version="21"
             target-sdk-version="35"
             permission="android.permission.READ_EXTERNAL_STORAGE"
             if="android" />
    <architecture name="armv7" if="android" />
    <architecture name="arm64" if="android" />

    <window width="720" height="1280"
            fps="60"
            background="#0B1020"
            orientation="portrait"
            fullscreen="true"
            if="android" />

    <source path="src" />
    <java path="android/java" if="android" />
    <!-- ASSETS -->
    <assets path="assets" rename="assets" />
    <assets path="assets/fonts/Terminus" rename="fonts/Terminus" type="font" embed="true" />
    <assets path="assets/fonts/DepartureMono" rename="fonts/DepartureMono" type="font" embed="true" />

    <haxelib name="openfl" />
    <haxelib name="lime" />
    <haxelib name="hxdiscord_rpc" />

</project>

